    "@selemondev/svgl-svelte": "^2.1.2",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
